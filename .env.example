# Copied to .env by `npm run setup`, which also writes a random JWT_SECRET.
PORT=4000
# Relative to the server/ folder.
DB_PATH=./data/orders.db
# Required, at least 32 characters. Leave it empty here; npm run setup fills it in .env.
JWT_SECRET=
NODE_ENV=development
# false is intentional for HTTP localhost. When this variable is absent and NODE_ENV=production, the server uses true.
COOKIE_SECURE=false
