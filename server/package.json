{
  "name": "@sarh/server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json && node ../scripts/copy-schema.cjs",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prove:duplicates": "tsx src/scripts/prove-no-duplicates.ts"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "better-sqlite3": "13.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "jsonwebtoken": "9.0.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "7.6.11",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "^24.0.0",
    "@types/supertest": "6.0.2",
    "supertest": "^7.2.0",
    "tsx": "^4.20.0",
    "typescript": "5.7.3",
    "vitest": "4.1.12"
  }
}
